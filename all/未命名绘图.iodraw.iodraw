        <mxCell id="Xv8LhegPP-w2HDhVmXxw-21" value="&#xa;HA + KT군(n=53&#xa;&#xa;" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;rounded=1;fontSize=14;fontStyle=0;strokeWidth=2;resizeParent=0;resizeLast=1;shadow=0;dashed=0;align=center;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;" parent="1" vertex="1">
