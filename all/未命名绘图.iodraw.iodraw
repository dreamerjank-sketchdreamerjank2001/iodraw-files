        <mxCell id="Xv8LhegPP-w2HDhVmXxw-22" value="&#xa;HA 주사 + 키네시오 테이핑&#xa;&#xa;" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;" parent="Xv8LhegPP-w2HDhVmXxw-21" vertex="1">
