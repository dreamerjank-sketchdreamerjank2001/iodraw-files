<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram name="第 1 页" id="DigQ3KU-GpIDn75Lfy1j">
    <mxGraphModel dx="1207" dy="809" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" background="#000000" math="0" shadow="0">
      <root>
        <object label="" aa="# -*- coding: utf-8 -*-&#xa;&quot;&quot;&quot;&#xa;Figure 1. Research Design and Measurement Procedure&#xa;韩文版研究设计与测量流程图&#xa;Author: ChatGPT&#xa;&#xa;需要：&#xa;pip install matplotlib&#xa;&quot;&quot;&quot;&#xa;&#xa;import matplotlib.pyplot as plt&#xa;from matplotlib.patches import FancyBboxPatch, Rectangle, Circle, FancyArrowPatch&#xa;from matplotlib.lines import Line2D&#xa;import matplotlib.font_manager as fm&#xa;&#xa;&#xa;# =========================================================&#xa;# 1. 字体设置&#xa;# =========================================================&#xa;&#xa;CANDIDATE_FONTS = [&#xa;    &quot;Malgun Gothic&quot;,          # Windows 韩文字体&#xa;    &quot;NanumGothic&quot;,           # 韩国常用字体&#xa;    &quot;Noto Sans CJK KR&quot;,      # Noto 韩文字体&#xa;    &quot;Noto Sans CJK SC&quot;,&#xa;    &quot;AppleGothic&quot;,           # macOS 韩文字体&#xa;    &quot;Microsoft YaHei&quot;,&#xa;    &quot;SimHei&quot;,&#xa;    &quot;Arial Unicode MS&quot;,&#xa;]&#xa;&#xa;available_fonts = {f.name for f in fm.fontManager.ttflist}&#xa;FONT_FAMILY = next((f for f in CANDIDATE_FONTS if f in available_fonts), &quot;DejaVu Sans&quot;)&#xa;&#xa;plt.rcParams[&quot;font.family&quot;] = FONT_FAMILY&#xa;plt.rcParams[&quot;axes.unicode_minus&quot;] = False&#xa;&#xa;&#xa;# =========================================================&#xa;# 2. 样式 STYLE&#xa;# =========================================================&#xa;&#xa;STYLE = {&#xa;    &quot;blue&quot;: &quot;#003E9C&quot;,&#xa;    &quot;blue_dark&quot;: &quot;#002E7A&quot;,&#xa;    &quot;blue_mid&quot;: &quot;#0B56C5&quot;,&#xa;    &quot;blue_light&quot;: &quot;#EFF6FF&quot;,&#xa;    &quot;blue_lighter&quot;: &quot;#F7FBFF&quot;,&#xa;    &quot;green&quot;: &quot;#DFF5E4&quot;,&#xa;    &quot;green_border&quot;: &quot;#1D8A3A&quot;,&#xa;    &quot;text&quot;: &quot;#111111&quot;,&#xa;    &quot;gray&quot;: &quot;#555555&quot;,&#xa;    &quot;white&quot;: &quot;#FFFFFF&quot;,&#xa;&#xa;    &quot;lw&quot;: 1.6,&#xa;    &quot;lw_thick&quot;: 2.2,&#xa;&#xa;    &quot;font_title&quot;: 24,&#xa;    &quot;font_section&quot;: 17,&#xa;    &quot;font_body&quot;: 12.5,&#xa;    &quot;font_small&quot;: 10.5,&#xa;    &quot;font_note&quot;: 10.5,&#xa;&#xa;    &quot;rounding&quot;: 1.4,&#xa;}&#xa;&#xa;&#xa;# =========================================================&#xa;# 3. 数据 DATA：节点位置、尺寸、文字&#xa;# 坐标系：x = 0~100, y = 0~140&#xa;# x, y 表示左下角坐标&#xa;# =========================================================&#xa;&#xa;NODES = {&#xa;    &quot;enrollment&quot;: {&#xa;        &quot;x&quot;: 15, &quot;y&quot;: 119, &quot;w&quot;: 70, &quot;h&quot;: 13,&#xa;        &quot;icon&quot;: &quot;P&quot;,&#xa;        &quot;title&quot;: &quot;대상자 등록&quot;,&#xa;        &quot;lines&quot;: [&#xa;            &quot;적격한 무릎 골관절염 환자 159명&quot;,&#xa;            &quot;광저우의과대학 제3부속병원 재활의학과&quot;,&#xa;            &quot;2025년 6월 ~ 2026년 3월&quot;,&#xa;        ],&#xa;        &quot;type&quot;: &quot;main&quot;,&#xa;    },&#xa;&#xa;    &quot;baseline&quot;: {&#xa;        &quot;x&quot;: 27, &quot;y&quot;: 96, &quot;w&quot;: 46, &quot;h&quot;: 18,&#xa;        &quot;icon&quot;: &quot;T0&quot;,&#xa;        &quot;title&quot;: &quot;사전검사 / 기초평가 (T0)&quot;,&#xa;        &quot;lines&quot;: [&#xa;            &quot;•  WOMAC 통증 및 신체기능 하위척도&quot;,&#xa;            &quot;•  VAS 통증 점수&quot;,&#xa;            &quot;•  대퇴사두근 근력 (QMS)&quot;,&#xa;            &quot;•  햄스트링 근력 (HMS)&quot;,&#xa;            &quot;•  증상 관련 지표&quot;,&#xa;        ],&#xa;        &quot;type&quot;: &quot;main&quot;,&#xa;    },&#xa;&#xa;    &quot;random&quot;: {&#xa;        &quot;x&quot;: 35, &quot;y&quot;: 84, &quot;w&quot;: 30, &quot;h&quot;: 9,&#xa;        &quot;icon&quot;: None,&#xa;        &quot;title&quot;: &quot;무작위 배정&quot;,&#xa;        &quot;lines&quot;: [&#xa;            &quot;N = 159&quot;,&#xa;            &quot;1:1:1 배정&quot;,&#xa;        ],&#xa;        &quot;type&quot;: &quot;random&quot;,&#xa;    },&#xa;&#xa;    &quot;ha&quot;: {&#xa;        &quot;x&quot;: 7, &quot;y&quot;: 68, &quot;w&quot;: 26, &quot;h&quot;: 10,&#xa;        &quot;header&quot;: &quot;HA군 (n = 53)&quot;,&#xa;        &quot;body&quot;: &quot;관절강내 HA 주사&quot;,&#xa;        &quot;type&quot;: &quot;group&quot;,&#xa;    },&#xa;&#xa;    &quot;kt&quot;: {&#xa;        &quot;x&quot;: 37, &quot;y&quot;: 68, &quot;w&quot;: 26, &quot;h&quot;: 10,&#xa;        &quot;header&quot;: &quot;KT군 (n = 53)&quot;,&#xa;        &quot;body&quot;: &quot;키네시오 테이핑&quot;,&#xa;        &quot;type&quot;: &quot;group&quot;,&#xa;    },&#xa;&#xa;    &quot;hakt&quot;: {&#xa;        &quot;x&quot;: 67, &quot;y&quot;: 68, &quot;w&quot;: 26, &quot;h&quot;: 10,&#xa;        &quot;header&quot;: &quot;HA + KT군 (n = 53)&quot;,&#xa;        &quot;body&quot;: &quot;관절강내 HA 주사 +\n키네시오 테이핑&quot;,&#xa;        &quot;type&quot;: &quot;group&quot;,&#xa;    },&#xa;&#xa;    &quot;intervention&quot;: {&#xa;        &quot;x&quot;: 18, &quot;y&quot;: 58, &quot;w&quot;: 64, &quot;h&quot;: 7,&#xa;        &quot;title&quot;: &quot;3주 중재 기간&quot;,&#xa;        &quot;lines&quot;: [&#xa;            &quot;기초시점(T0) ~ 3주차&quot;,&#xa;        ],&#xa;        &quot;type&quot;: &quot;green&quot;,&#xa;    },&#xa;&#xa;    &quot;followup&quot;: {&#xa;        &quot;x&quot;: 16, &quot;y&quot;: 29, &quot;w&quot;: 68, &quot;h&quot;: 25,&#xa;        &quot;title&quot;: &quot;반복 결과 평가&quot;,&#xa;        &quot;type&quot;: &quot;followup&quot;,&#xa;    },&#xa;&#xa;    &quot;analysis&quot;: {&#xa;        &quot;x&quot;: 27, &quot;y&quot;: 19, &quot;w&quot;: 46, &quot;h&quot;: 6,&#xa;        &quot;title&quot;: &quot;자료 분석&quot;,&#xa;        &quot;lines&quot;: [&#xa;            &quot;ITT 원칙&quot;,&#xa;        ],&#xa;        &quot;type&quot;: &quot;main&quot;,&#xa;    },&#xa;&#xa;    &quot;abbr&quot;: {&#xa;        &quot;x&quot;: 10, &quot;y&quot;: 3, &quot;w&quot;: 80, &quot;h&quot;: 10,&#xa;        &quot;type&quot;: &quot;abbr&quot;,&#xa;    },&#xa;}&#xa;&#xa;&#xa;# =========================================================&#xa;# 4. 连接点 ANCHORS&#xa;# =========================================================&#xa;&#xa;def anchor(node_name, pos):&#xa;    &quot;&quot;&quot;&#xa;    返回节点指定连接点坐标。&#xa;    pos 可选：&#xa;    top, bottom, left, right, center,&#xa;    top_left, top_right, bottom_left, bottom_right&#xa;    &quot;&quot;&quot;&#xa;    n = NODES[node_name]&#xa;    x, y, w, h = n[&quot;x&quot;], n[&quot;y&quot;], n[&quot;w&quot;], n[&quot;h&quot;]&#xa;&#xa;    points = {&#xa;        &quot;top&quot;: (x + w / 2, y + h),&#xa;        &quot;bottom&quot;: (x + w / 2, y),&#xa;        &quot;left&quot;: (x, y + h / 2),&#xa;        &quot;right&quot;: (x + w, y + h / 2),&#xa;        &quot;center&quot;: (x + w / 2, y + h / 2),&#xa;        &quot;top_left&quot;: (x, y + h),&#xa;        &quot;top_right&quot;: (x + w, y + h),&#xa;        &quot;bottom_left&quot;: (x, y),&#xa;        &quot;bottom_right&quot;: (x + w, y),&#xa;    }&#xa;    return points[pos]&#xa;&#xa;&#xa;# =========================================================&#xa;# 5. 链接 EDGES&#xa;# 每条线由多个点组成，可以自由控制折线连接&#xa;# =========================================================&#xa;&#xa;EDGES = [&#xa;    # 대상자 등록 -&gt; 기초평가&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;enrollment&quot;, &quot;bottom&quot;),&#xa;            anchor(&quot;baseline&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;&#xa;    # 기초평가 -&gt; 무작위 배정&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;baseline&quot;, &quot;bottom&quot;),&#xa;            anchor(&quot;random&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;&#xa;    # 무작위 배정 -&gt; 三组分支&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;random&quot;, &quot;bottom&quot;),&#xa;            (50, 80),&#xa;            (20, 80),&#xa;            anchor(&quot;ha&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;random&quot;, &quot;bottom&quot;),&#xa;            anchor(&quot;kt&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;random&quot;, &quot;bottom&quot;),&#xa;            (50, 80),&#xa;            (80, 80),&#xa;            anchor(&quot;hakt&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;&#xa;    # 三组汇合 -&gt; 3주 중재 기간&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;ha&quot;, &quot;bottom&quot;),&#xa;            (20, 65),&#xa;            (50, 65),&#xa;            anchor(&quot;intervention&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;kt&quot;, &quot;bottom&quot;),&#xa;            (50, 65),&#xa;            anchor(&quot;intervention&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;hakt&quot;, &quot;bottom&quot;),&#xa;            (80, 65),&#xa;            (50, 65),&#xa;            anchor(&quot;intervention&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;&#xa;    # 중재 -&gt; 반복 평가&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;intervention&quot;, &quot;bottom&quot;),&#xa;            anchor(&quot;followup&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;&#xa;    # 반복 평가 -&gt; 분석&#xa;    {&#xa;        &quot;points&quot;: [&#xa;            anchor(&quot;followup&quot;, &quot;bottom&quot;),&#xa;            anchor(&quot;analysis&quot;, &quot;top&quot;),&#xa;        ],&#xa;        &quot;arrow&quot;: True,&#xa;    },&#xa;]&#xa;&#xa;&#xa;# =========================================================&#xa;# 6. 绘图函数&#xa;# =========================================================&#xa;&#xa;def draw_rounded_box(ax, x, y, w, h, fc=None, ec=None, lw=None, radius=None):&#xa;    if fc is None:&#xa;        fc = STYLE[&quot;blue_lighter&quot;]&#xa;    if ec is None:&#xa;        ec = STYLE[&quot;blue&quot;]&#xa;    if lw is None:&#xa;        lw = STYLE[&quot;lw&quot;]&#xa;    if radius is None:&#xa;        radius = STYLE[&quot;rounding&quot;]&#xa;&#xa;    box = FancyBboxPatch(&#xa;        (x, y), w, h,&#xa;        boxstyle=f&quot;round,pad=0.02,rounding_size={radius}&quot;,&#xa;        linewidth=lw,&#xa;        edgecolor=ec,&#xa;        facecolor=fc,&#xa;        zorder=2,&#xa;    )&#xa;    ax.add_patch(box)&#xa;    return box&#xa;&#xa;&#xa;def draw_icon_circle(ax, cx, cy, label, r=2.5):&#xa;    circle = Circle(&#xa;        (cx, cy), r,&#xa;        facecolor=STYLE[&quot;blue_mid&quot;],&#xa;        edgecolor=STYLE[&quot;blue_dark&quot;],&#xa;        linewidth=1.0,&#xa;        zorder=4,&#xa;    )&#xa;    ax.add_patch(circle)&#xa;&#xa;    ax.text(&#xa;        cx, cy, label,&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=10.5,&#xa;        color=STYLE[&quot;white&quot;],&#xa;        fontweight=&quot;bold&quot;,&#xa;        zorder=5,&#xa;    )&#xa;&#xa;&#xa;def draw_main_node(ax, name):&#xa;    n = NODES[name]&#xa;    x, y, w, h = n[&quot;x&quot;], n[&quot;y&quot;], n[&quot;w&quot;], n[&quot;h&quot;]&#xa;&#xa;    fc = STYLE[&quot;blue_lighter&quot;]&#xa;    ec = STYLE[&quot;blue&quot;]&#xa;    if n[&quot;type&quot;] == &quot;green&quot;:&#xa;        fc = STYLE[&quot;green&quot;]&#xa;        ec = STYLE[&quot;green_border&quot;]&#xa;&#xa;    draw_rounded_box(ax, x, y, w, h, fc=fc, ec=ec)&#xa;&#xa;    if n.get(&quot;icon&quot;):&#xa;        draw_icon_circle(ax, x + 5.2, y + h - 4.0, n[&quot;icon&quot;], r=2.4)&#xa;&#xa;    # 标题&#xa;    ax.text(&#xa;        x + w / 2, y + h - 3.0,&#xa;        n.get(&quot;title&quot;, &quot;&quot;),&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=STYLE[&quot;font_section&quot;],&#xa;        fontweight=&quot;bold&quot;,&#xa;        color=STYLE[&quot;blue_dark&quot;] if n[&quot;type&quot;] != &quot;green&quot; else STYLE[&quot;green_border&quot;],&#xa;        zorder=5,&#xa;    )&#xa;&#xa;    # 正文&#xa;    lines = n.get(&quot;lines&quot;, [])&#xa;    if name == &quot;analysis&quot;:&#xa;        start_y = y + h - 3.8&#xa;        fs = 11.5&#xa;        dy = 2.2&#xa;    elif n[&quot;type&quot;] == &quot;green&quot;:&#xa;        start_y = y + h - 4.8&#xa;        fs = 13&#xa;        dy = 2.3&#xa;    else:&#xa;        start_y = y + h - 6.0&#xa;        fs = STYLE[&quot;font_body&quot;]&#xa;        dy = 2.8&#xa;&#xa;    for i, line in enumerate(lines):&#xa;        ax.text(&#xa;            x + w / 2, start_y - i * dy,&#xa;            line,&#xa;            ha=&quot;center&quot; if not line.startswith(&quot;•&quot;) else &quot;left&quot;,&#xa;            va=&quot;center&quot;,&#xa;            fontsize=fs,&#xa;            color=STYLE[&quot;text&quot;],&#xa;            zorder=5,&#xa;        )&#xa;&#xa;&#xa;def draw_random_node(ax, name):&#xa;    n = NODES[name]&#xa;    x, y, w, h = n[&quot;x&quot;], n[&quot;y&quot;], n[&quot;w&quot;], n[&quot;h&quot;]&#xa;&#xa;    draw_rounded_box(ax, x, y, w, h, fc=STYLE[&quot;blue_lighter&quot;], ec=STYLE[&quot;blue&quot;])&#xa;&#xa;    # 中间横线&#xa;    ax.add_line(&#xa;        Line2D(&#xa;            [x, x + w], [y + 3.0, y + 3.0],&#xa;            color=STYLE[&quot;blue&quot;],&#xa;            linewidth=1.0,&#xa;            zorder=4,&#xa;        )&#xa;    )&#xa;&#xa;    ax.text(&#xa;        x + w / 2, y + h - 2.4,&#xa;        n[&quot;title&quot;],&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=STYLE[&quot;font_section&quot;],&#xa;        fontweight=&quot;bold&quot;,&#xa;        color=STYLE[&quot;blue_dark&quot;],&#xa;    )&#xa;&#xa;    ax.text(&#xa;        x + w / 2, y + h - 5.0,&#xa;        n[&quot;lines&quot;][0],&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=13,&#xa;        color=STYLE[&quot;text&quot;],&#xa;    )&#xa;&#xa;    ax.text(&#xa;        x + w / 2, y + 1.5,&#xa;        n[&quot;lines&quot;][1],&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=13,&#xa;        color=STYLE[&quot;text&quot;],&#xa;    )&#xa;&#xa;&#xa;def draw_group_node(ax, name):&#xa;    n = NODES[name]&#xa;    x, y, w, h = n[&quot;x&quot;], n[&quot;y&quot;], n[&quot;w&quot;], n[&quot;h&quot;]&#xa;&#xa;    draw_rounded_box(ax, x, y, w, h, fc=STYLE[&quot;blue_lighter&quot;], ec=STYLE[&quot;blue&quot;])&#xa;&#xa;    # 深蓝色标题栏&#xa;    header_h = 3.9&#xa;    header = Rectangle(&#xa;        (x, y + h - header_h),&#xa;        w, header_h,&#xa;        facecolor=STYLE[&quot;blue_mid&quot;],&#xa;        edgecolor=STYLE[&quot;blue_mid&quot;],&#xa;        zorder=3,&#xa;    )&#xa;    ax.add_patch(header)&#xa;&#xa;    ax.text(&#xa;        x + w / 2, y + h - header_h / 2,&#xa;        n[&quot;header&quot;],&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=13.5,&#xa;        fontweight=&quot;bold&quot;,&#xa;        color=STYLE[&quot;white&quot;],&#xa;        zorder=5,&#xa;    )&#xa;&#xa;    ax.text(&#xa;        x + w / 2, y + 3.0,&#xa;        n[&quot;body&quot;],&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=12.5,&#xa;        color=STYLE[&quot;text&quot;],&#xa;        linespacing=1.5,&#xa;        zorder=5,&#xa;    )&#xa;&#xa;&#xa;def draw_followup_node(ax, name):&#xa;    n = NODES[name]&#xa;    x, y, w, h = n[&quot;x&quot;], n[&quot;y&quot;], n[&quot;w&quot;], n[&quot;h&quot;]&#xa;&#xa;    draw_rounded_box(ax, x, y, w, h, fc=STYLE[&quot;blue_lighter&quot;], ec=STYLE[&quot;blue&quot;])&#xa;&#xa;    ax.text(&#xa;        x + w / 2, y + h - 3.2,&#xa;        n[&quot;title&quot;],&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=STYLE[&quot;font_section&quot;],&#xa;        fontweight=&quot;bold&quot;,&#xa;        color=STYLE[&quot;blue_dark&quot;],&#xa;    )&#xa;&#xa;    # T1 T2 T3 时间点&#xa;    t_y = y + h - 8.0&#xa;    t_xs = [x + 14, x + w / 2, x + w - 14]&#xa;    t_labels = [&#xa;        (&quot;T1&quot;, &quot;1주차 종료\n(중재 1주 후)&quot;),&#xa;        (&quot;T2&quot;, &quot;2주차 종료\n(중재 2주 후)&quot;),&#xa;        (&quot;T3&quot;, &quot;3주차 종료\n(중재 종료 시점)&quot;),&#xa;    ]&#xa;&#xa;    # 虚线连接&#xa;    ax.plot(&#xa;        [t_xs[0], t_xs[1], t_xs[2]],&#xa;        [t_y, t_y, t_y],&#xa;        color=STYLE[&quot;blue&quot;],&#xa;        linestyle=&quot;:&quot;,&#xa;        linewidth=1.5,&#xa;        zorder=3,&#xa;    )&#xa;&#xa;    for tx, (tag, desc) in zip(t_xs, t_labels):&#xa;        # T标签小框&#xa;        draw_rounded_box(&#xa;            ax, tx - 2.5, t_y - 1.2, 5, 2.4,&#xa;            fc=STYLE[&quot;blue_mid&quot;], ec=STYLE[&quot;blue_mid&quot;], lw=1.0, radius=0.8&#xa;        )&#xa;        ax.text(&#xa;            tx, t_y,&#xa;            tag,&#xa;            ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;            fontsize=11.5,&#xa;            fontweight=&quot;bold&quot;,&#xa;            color=STYLE[&quot;white&quot;],&#xa;            zorder=5,&#xa;        )&#xa;        ax.text(&#xa;            tx, t_y - 4.0,&#xa;            desc,&#xa;            ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;            fontsize=STYLE[&quot;font_small&quot;],&#xa;            color=STYLE[&quot;text&quot;],&#xa;            linespacing=1.35,&#xa;        )&#xa;&#xa;    # 分割线&#xa;    ax.add_line(&#xa;        Line2D(&#xa;            [x + 5, x + w - 5],&#xa;            [y + 11.5, y + 11.5],&#xa;            color=STYLE[&quot;blue&quot;],&#xa;            linewidth=1.0,&#xa;            zorder=4,&#xa;        )&#xa;    )&#xa;&#xa;    # 结果指标&#xa;    ax.text(&#xa;        x + 6, y + 9.7,&#xa;        &quot;각 시점에서 동일한 결과지표를 평가함:&quot;,&#xa;        ha=&quot;left&quot;, va=&quot;center&quot;,&#xa;        fontsize=12,&#xa;        fontweight=&quot;bold&quot;,&#xa;        color=STYLE[&quot;blue_dark&quot;],&#xa;    )&#xa;&#xa;    bullets = [&#xa;        &quot;•  WOMAC 통증 및 신체기능 하위척도&quot;,&#xa;        &quot;•  VAS 통증 점수&quot;,&#xa;        &quot;•  대퇴사두근 근력 (QMS)&quot;,&#xa;        &quot;•  햄스트링 근력 (HMS)&quot;,&#xa;        &quot;•  증상 관련 지표&quot;,&#xa;    ]&#xa;&#xa;    for i, line in enumerate(bullets):&#xa;        ax.text(&#xa;            x + 8, y + 7.8 - i * 1.75,&#xa;            line,&#xa;            ha=&quot;left&quot;, va=&quot;center&quot;,&#xa;            fontsize=11.5,&#xa;            color=STYLE[&quot;text&quot;],&#xa;        )&#xa;&#xa;&#xa;def draw_abbr_node(ax, name):&#xa;    n = NODES[name]&#xa;    x, y, w, h = n[&quot;x&quot;], n[&quot;y&quot;], n[&quot;w&quot;], n[&quot;h&quot;]&#xa;&#xa;    draw_rounded_box(&#xa;        ax, x, y, w, h,&#xa;        fc=STYLE[&quot;white&quot;],&#xa;        ec=STYLE[&quot;blue&quot;],&#xa;        lw=1.2,&#xa;        radius=1.0,&#xa;    )&#xa;&#xa;    left_lines = [&#xa;        (&quot;HA:&quot;, &quot;히알루론산 / 히알루론산나트륨&quot;),&#xa;        (&quot;KT:&quot;, &quot;키네시오 테이핑&quot;),&#xa;        (&quot;VAS:&quot;, &quot;시각상사척도&quot;),&#xa;    ]&#xa;&#xa;    right_lines = [&#xa;        (&quot;WOMAC:&quot;, &quot;Western Ontario and McMaster\nUniversities 골관절염 지수&quot;),&#xa;        (&quot;QMS:&quot;, &quot;대퇴사두근 근력&quot;),&#xa;        (&quot;HMS:&quot;, &quot;햄스트링 근력&quot;),&#xa;    ]&#xa;&#xa;    for i, (key, val) in enumerate(left_lines):&#xa;        yy = y + h - 2.2 - i * 2.4&#xa;        ax.text(x + 3, yy, key, ha=&quot;left&quot;, va=&quot;center&quot;,&#xa;                fontsize=10.5, color=STYLE[&quot;blue_dark&quot;], fontweight=&quot;bold&quot;)&#xa;        ax.text(x + 8, yy, val, ha=&quot;left&quot;, va=&quot;center&quot;,&#xa;                fontsize=10.5, color=STYLE[&quot;text&quot;])&#xa;&#xa;    for i, (key, val) in enumerate(right_lines):&#xa;        yy = y + h - 2.2 - i * 2.8&#xa;        ax.text(x + 43, yy, key, ha=&quot;left&quot;, va=&quot;center&quot;,&#xa;                fontsize=10.5, color=STYLE[&quot;blue_dark&quot;], fontweight=&quot;bold&quot;)&#xa;        ax.text(x + 52, yy, val, ha=&quot;left&quot;, va=&quot;center&quot;,&#xa;                fontsize=10.5, color=STYLE[&quot;text&quot;], linespacing=1.1)&#xa;&#xa;&#xa;def draw_poly_arrow(ax, points, arrow=True, dashed=False):&#xa;    &quot;&quot;&quot;&#xa;    画折线连接。&#xa;    points: [(x1,y1), (x2,y2), ...]&#xa;    arrow=True 表示最后一段带箭头。&#xa;    &quot;&quot;&quot;&#xa;    color = STYLE[&quot;blue&quot;]&#xa;&#xa;    if len(points) &lt; 2:&#xa;        return&#xa;&#xa;    # 先画除最后一段以外的普通线&#xa;    for i in range(len(points) - 2):&#xa;        x1, y1 = points[i]&#xa;        x2, y2 = points[i + 1]&#xa;        ax.add_line(&#xa;            Line2D(&#xa;                [x1, x2], [y1, y2],&#xa;                color=color,&#xa;                linewidth=STYLE[&quot;lw_thick&quot;],&#xa;                linestyle=&quot;--&quot; if dashed else &quot;-&quot;,&#xa;                zorder=1,&#xa;            )&#xa;        )&#xa;&#xa;    # 最后一段&#xa;    x1, y1 = points[-2]&#xa;    x2, y2 = points[-1]&#xa;&#xa;    if arrow:&#xa;        arr = FancyArrowPatch(&#xa;            (x1, y1), (x2, y2),&#xa;            arrowstyle=&quot;-|&gt;&quot;,&#xa;            mutation_scale=14,&#xa;            linewidth=STYLE[&quot;lw_thick&quot;],&#xa;            color=color,&#xa;            linestyle=&quot;--&quot; if dashed else &quot;-&quot;,&#xa;            shrinkA=0,&#xa;            shrinkB=2,&#xa;            zorder=1,&#xa;        )&#xa;        ax.add_patch(arr)&#xa;    else:&#xa;        ax.add_line(&#xa;            Line2D(&#xa;                [x1, x2], [y1, y2],&#xa;                color=color,&#xa;                linewidth=STYLE[&quot;lw_thick&quot;],&#xa;                linestyle=&quot;--&quot; if dashed else &quot;-&quot;,&#xa;                zorder=1,&#xa;            )&#xa;        )&#xa;&#xa;&#xa;# =========================================================&#xa;# 7. 主绘图程序&#xa;# =========================================================&#xa;&#xa;def draw_figure():&#xa;    fig, ax = plt.subplots(figsize=(10, 14.14), dpi=300)&#xa;&#xa;    ax.set_xlim(0, 100)&#xa;    ax.set_ylim(0, 140)&#xa;    ax.axis(&quot;off&quot;)&#xa;&#xa;    # 背景&#xa;    ax.add_patch(&#xa;        Rectangle(&#xa;            (0, 0), 100, 140,&#xa;            facecolor=&quot;white&quot;,&#xa;            edgecolor=&quot;none&quot;,&#xa;            zorder=0,&#xa;        )&#xa;    )&#xa;&#xa;    # 标题&#xa;    ax.text(&#xa;        50, 136.5,&#xa;        &quot;그림 1. 연구 설계 및 측정 절차&quot;,&#xa;        ha=&quot;center&quot;, va=&quot;center&quot;,&#xa;        fontsize=STYLE[&quot;font_title&quot;],&#xa;        fontweight=&quot;bold&quot;,&#xa;        color=STYLE[&quot;blue_dark&quot;],&#xa;    )&#xa;&#xa;    # 连线先画，节点后画，避免线压住框&#xa;    for edge in EDGES:&#xa;        draw_poly_arrow(&#xa;            ax,&#xa;            edge[&quot;points&quot;],&#xa;            arrow=edge.get(&quot;arrow&quot;, True),&#xa;            dashed=edge.get(&quot;dashed&quot;, False),&#xa;        )&#xa;&#xa;    # 节点&#xa;    draw_main_node(ax, &quot;enrollment&quot;)&#xa;    draw_main_node(ax, &quot;baseline&quot;)&#xa;    draw_random_node(ax, &quot;random&quot;)&#xa;    draw_group_node(ax, &quot;ha&quot;)&#xa;    draw_group_node(ax, &quot;kt&quot;)&#xa;    draw_group_node(ax, &quot;hakt&quot;)&#xa;    draw_main_node(ax, &quot;intervention&quot;)&#xa;    draw_followup_node(ax, &quot;followup&quot;)&#xa;    draw_main_node(ax, &quot;analysis&quot;)&#xa;    draw_abbr_node(ax, &quot;abbr&quot;)&#xa;&#xa;    # 输出&#xa;    plt.savefig(&quot;figure1_research_design_ko.png&quot;, dpi=600, bbox_inches=&quot;tight&quot;)&#xa;    plt.savefig(&quot;figure1_research_design_ko.svg&quot;, bbox_inches=&quot;tight&quot;)&#xa;    plt.savefig(&quot;figure1_research_design_ko.pdf&quot;, bbox_inches=&quot;tight&quot;)&#xa;&#xa;    plt.show()&#xa;&#xa;&#xa;if __name__ == &quot;__main__&quot;:&#xa;    draw_figure()" id="0">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
